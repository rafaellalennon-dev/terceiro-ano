<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terceirão 2026 | Nossas Memórias ✨</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="hero">
        <div class="hero-content">
            <span class="tag">Turma 2026 • Para sempre na história</span>
            <h1>Nossas Memórias do Terceirão</h1>
            <p>Entre cafés no intervalo, desespero pré-prova e as melhores risadas da vida. O fim de um ciclo e o começo de tudo.</p>
            <button id="btn-nova-memoria" class="btn-principal">+ Adicionar Memória</button>
        </div>
    </header>

    <main class="container">
        <!-- Filtros por categoria -->
        <nav class="filtros">
            <button class="filtro-btn active" data-categoria="todas">Todas</button>
            <button class="filtro-btn" data-categoria="eventos">Eventos & Trotes</button>
            <button class="filtro-btn" data-categoria="sala">Na Sala de Aula</button>
            <button class="filtro-btn" data-categoria="viagens">Passeios</button>
        </nav>

        <!-- Mural de Polaroids -->
        <section id="mural-memorias" class="mural-grid">
            <!-- As memórias serão carregadas aqui pelo JavaScript -->
        </section>

        <!-- Cápsula do Tempo / Recados -->
        <section class="capsula-tempo">
            <h2>💌 Mural de Recados da Turma</h2>
            <p>Deixe uma frase marcante ou um recado para relermos daqui a 10 anos:</p>
            
            <form id="form-recado" class="form-recado">
                <input type="text" id="autor-recado" placeholder="Seu nome ou apelido" required>
                <textarea id="texto-recado" rows="3" placeholder="Escreva sua mensagem..." required></textarea>
                <button type="submit" class="btn-secundario">Fixar no Mural</button>
            </form>

            <div id="lista-recados" class="recados-grid"></div>
        </section>
    </main>

    <!-- Modal para adicionar nova foto/memória -->
    <div id="modal-memoria" class="modal hidden">
        <div class="modal-content">
            <span id="fechar-modal" class="fechar">&times;</span>
            <h3>Nova Lembrança 📸</h3>
            <form id="form-memoria">
                <label>Título do momento:</label>
                <input type="text" id="titulo-memoria" placeholder="Ex: Trote do Pijama" required>

                <label>Categoria:</label>
                <select id="categoria-memoria">
                    <option value="eventos">Eventos & Trotes</option>
                    <option value="sala">Na Sala de Aula</option>
                    <option value="viagens">Passeios</option>
                </select>

                <label>Link da Foto (URL):</label>
                <input type="url" id="imagem-memoria" placeholder="Cole o link da imagem aqui" required>

                <label>Legenda / História:</label>
                <textarea id="descricao-memoria" rows="3" placeholder="O que aconteceu nesse dia?" required></textarea>

                <button type="submit" class="btn-principal">Salvar Polaroid</button>
            </form>
        </div>
    </div>

    <footer>
        <p>Feito com 💖 pela melhor turma do Terceirão • 2026</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
